# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed — .env.example is the committed template.
#
# These are all client-safe values (not secrets): the Firebase web config and the
# Supabase anon/publishable key are both designed to be visible in the browser.
# Real access control is enforced by Firebase Auth rules and Supabase Row-Level Security.

# Firebase web app config
# Get from: Firebase Console -> hae-vuma-92fca -> Project settings (gear icon) -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase project config
# Get from: Supabase Dashboard -> hae-vuma -> Project settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: where the "Back to Ekhaya Connect" link in the top strip goes.
# Defaults to https://shakabornman.github.io/ekhaya-connect/ when left empty.
NEXT_PUBLIC_EKHAYA_CONNECT_URL=
